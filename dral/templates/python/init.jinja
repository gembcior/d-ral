{% import 'utils.jinja' as utils with context %}
{%- include 'header.jinja' +%}

{% for name in groups %}
from .{{ name | snakeCaseAdvanced }} import {{ utils.getGroupName(name) }}
{% endfor %}

class {{ device | upperCamelCase }}Top:
    """Aggregates all top-level register groups for the {{ device | upperCamelCase }} scope."""

